# Copy this file to `.env.local` and fill in the values from your Supabase project.
# `.env.local` is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Public — safe to expose to the browser. Both are inlined into the client bundle.
# Supabase dashboard: Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key. Newer projects label this "Publishable key" and it starts
# with `sb_publishable_`; older projects label it "anon / public" and it is a JWT
# starting with `eyJ`. Either one goes here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of this app. Used to build the email verification / password reset
# redirect links, and must match the Site URL configured in Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only — MUST NOT be prefixed with NEXT_PUBLIC_.
# These bypass Row Level Security. Leaking either one compromises the database.
# ---------------------------------------------------------------------------

# Newer projects label this "Secret key" (`sb_secret_...`); older projects label
# it "service_role" (a JWT). Read only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used ONLY by `npm run db:types` to generate
# src/types/database.ts. The running app never reads this.
# Supabase dashboard: Project Settings -> Database -> Connection string -> URI.
# Prefer the "Session pooler" string (port 5432) — the direct connection host is
# often IPv6-only and will not resolve on a typical home/Windows network.
# Contains your database password, so treat it like a secret.
SUPABASE_DB_URL=
